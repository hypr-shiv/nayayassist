# LLM Provider: "none" (rule-based offline), "ollama", or "gemini"
LLM_PROVIDER=none

# Ollama local configuration (optimized for 8GB RAM systems)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Gemini API configuration (demo synthetic data only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Tesseract OCR language(s)
OCR_LANG=eng

# Upload and storage limits
MAX_UPLOAD_MB=15
RETRIEVAL_MIN_TERMS=2
DATA_DIR=./data_store

# Operating mode: "demo" or "real" (blocks external cloud LLM in real mode per ADR-006)
DATA_MODE=demo

# Data retention in days (DPDPA 2023)
RETENTION_DAYS=1
